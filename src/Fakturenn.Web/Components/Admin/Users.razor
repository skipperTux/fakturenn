@page "/admin/users"
@using Fakturenn.Modules.Identity.Authorization
@using Fakturenn.Modules.Identity.Domain
@using Fakturenn.Modules.Identity.Persistence
@* FormError lives beside the account endpoints it mirrors, not in this folder. *@
@using Fakturenn.Web.Components.Account
@* AntiforgeryToken lives in Components.Forms, which _Imports.razor does not carry. *@
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.EntityFrameworkCore
@* Reading the list needs users.read; every mutation below posts to an endpoint gated on
   users.manage. Two permissions, two enforcement sites -- which is why users.read survived
   the spec review's cull and roles.read did not.

   This page is deliberately NOT on the enrolment gate's allowlist. An administrator who
   has not enrolled a second factor is sent to enrolment before reaching it, which is the
   intended behaviour: administration is not an exemption from the account's own
   obligations. *@
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = Permissions.UsersRead)]
@inject IdentityDbContext Db
@inject IStringLocalizer<SharedResource> Localizer

<PageTitle>@Localizer["Admin_Users_PageTitle"]</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true" data-testid="admin-users-title">@Localizer["Admin_Users_Title"]</MudText>

@* No Message: /account/admin/* redirects with either Identity's own validation
   descriptions or Account_Error_NoSuchAccount, both already in the request's language. *@
<FormError Error="@Error" TestId="admin-error" />

<MudTable Items="_users" Class="mb-8" data-testid="user-table">
    <HeaderContent>
        <MudTh>@Localizer["Admin_Users_Column_Email"]</MudTh>
        <MudTh>@Localizer["Admin_Users_Column_DisplayName"]</MudTh>
        <MudTh>@Localizer["Admin_Users_Column_TwoFactor"]</MudTh>
        <MudTh>@Localizer["Admin_Users_Column_LockedUntil"]</MudTh>
        <MudTh>@Localizer["Admin_Users_Column_Actions"]</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd>@context.Email</MudTd>
        <MudTd>@context.DisplayName</MudTd>
        <MudTd>@(context.TwoFactorEnabled ? Localizer["Admin_Users_TwoFactorEnrolled"] : Localizer["Admin_Users_TwoFactorPending"])</MudTd>
        @* LockoutEnd, never AccessFailedCount. UserManager.AccessFailedAsync zeroes that
           column in the same call that sets LockoutEnd, so it reads 0 exactly when a
           reader most expects it to read 5. *@
        <MudTd>@(context.LockoutEnd?.ToString("u") ?? "-")</MudTd>
        <MudTd>
            <form method="post" action="/account/admin/clear-mfa" class="d-inline">
                <AntiforgeryToken />
                <input type="hidden" name="email" value="@context.Email" />
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Text" Size="Size.Small">
                    @Localizer["Admin_Users_ClearTwoFactor"]
                </MudButton>
            </form>
            <form method="post" action="/account/admin/set-lockout" class="d-inline">
                <AntiforgeryToken />
                <input type="hidden" name="email" value="@context.Email" />
                @* Locking the last administrator is permitted, and nothing here guards
                   against it. Their permissions cannot be stripped either -- not because a
                   guard refuses, but because E02a ships no way to remove a role or a
                   permission at all: roles are seeded by --migrate and edited by SQL. The
                   lock button is therefore the one action on this page that can lock an
                   instance out of its own administration, which is exactly why the CLI has
                   --unlock-user. E02b adds role management and the guard that goes with it. *@
                <input type="hidden" name="locked" value="@(IsLocked(context) ? "false" : "true")" />
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Text" Size="Size.Small">
                    @(IsLocked(context) ? Localizer["Admin_Users_Unlock"] : Localizer["Admin_Users_Lock"])
                </MudButton>
            </form>
        </MudTd>
    </RowTemplate>
</MudTable>

<MudText Typo="Typo.h5" GutterBottom="true">@Localizer["Admin_Users_CreateTitle"]</MudText>
<form method="post" action="/account/admin/create-user" data-testid="create-user-form">
    <AntiforgeryToken />
    <MudTextField T="string" Label="@Localizer["Admin_Users_CreateEmail"]" InputType="InputType.Email" name="email" Value="@ValueFor("create-user", Email)" Required="true" autocomplete="off" data-testid="create-user-email" />
    <MudTextField T="string" Label="@Localizer["Admin_Users_CreateDisplayName"]" name="displayName" Value="@ValueFor("create-user", DisplayName)" Required="true" autocomplete="off" data-testid="create-user-display-name" />
    <MudTextField T="string" Label="@Localizer["Admin_Users_CreateInitialPassword"]" InputType="InputType.Password" name="password" Required="true" autocomplete="off" data-testid="create-user-password" />
    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Class="mt-4" data-testid="create-user-submit">
        @Localizer["Admin_Users_CreateSubmit"]
    </MudButton>
</form>

<MudText Typo="Typo.h5" GutterBottom="true" Class="mt-8">@Localizer["Admin_Users_ResetTitle"]</MudText>
<MudText Typo="Typo.body2" Class="mb-4">
    @Localizer["Admin_Users_ResetExplanation"]
</MudText>
<form method="post" action="/account/admin/reset-password" data-testid="reset-password-form">
    <AntiforgeryToken />
    <MudTextField T="string" Label="@Localizer["Admin_Users_ResetEmail"]" InputType="InputType.Email" name="email" Value="@ValueFor("reset-password", Email)" Required="true" autocomplete="off" data-testid="reset-password-email" />
    <MudTextField T="string" Label="@Localizer["Admin_Users_ResetNewPassword"]" InputType="InputType.Password" name="password" Required="true" autocomplete="off" data-testid="reset-password-password" />
    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Class="mt-4" data-testid="reset-password-submit">
        @Localizer["Admin_Users_ResetSubmit"]
    </MudButton>
</form>

@code {
    private List<ApplicationUser> _users = [];

    [SupplyParameterFromQuery(Name = "error")]
    private string? Error { get; set; }

    // Which of this page's forms was refused. The two below both post an "email" field, so
    // without this the address typed into one would come back filled into the other -- and
    // "reset this person's password" is not a form to put an address into that nobody asked
    // for. AccountForms sends it on every rejection; single-form pages ignore it.
    [SupplyParameterFromQuery(Name = "form")]
    private string? Form { get; set; }

    [SupplyParameterFromQuery(Name = "email")]
    private string? Email { get; set; }

    [SupplyParameterFromQuery(Name = "displayName")]
    private string? DisplayName { get; set; }

    private static bool IsLocked(ApplicationUser user) => user.LockoutEnd > DateTimeOffset.UtcNow;

    private string? ValueFor(string form, string? value) =>
        string.Equals(Form, form, StringComparison.Ordinal) ? value : null;

    protected override async Task OnInitializedAsync() =>
        _users = await Db.Users.AsNoTracking().OrderBy(user => user.Email).ToListAsync();
}
