@page "/account/enrol-totp"
@using System.Text
@using Fakturenn.Modules.Identity.Domain
@* AntiforgeryToken lives in Components.Forms, which _Imports.razor does not carry. *@
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Identity
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject UserManager<ApplicationUser> Users
@inject SignInManager<ApplicationUser> SignIn
@inject IHttpContextAccessor HttpContextAccessor
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResource> Localizer

<PageTitle>@Localizer["Account_EnrolTotp_PageTitle"]</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true" data-testid="enrol-title">@Localizer["Account_EnrolTotp_Title"]</MudText>
<MudText Typo="Typo.body2" Class="mb-4">
    @Localizer["Account_EnrolTotp_Explanation"]
</MudText>

<FormError Error="@Error" Message="@Localizer["Account_EnrolTotp_InvalidCode"]" TestId="enrol-error" />

<MudPaper Class="pa-4 mb-4">
    <MudText Typo="Typo.caption">@Localizer["Account_EnrolTotp_ManualEntryKey"]</MudText>
    <MudText Typo="Typo.h6" data-testid="totp-key">@_formattedKey</MudText>
</MudPaper>

<form method="post" action="/account/enrol-totp/verify" data-testid="enrol-form">
    <AntiforgeryToken />
    <MudTextField T="string" Label="@Localizer["Account_EnrolTotp_Code"]" name="code" Required="true" autocomplete="one-time-code" InputMode="InputMode.numeric" data-testid="enrol-code" />
    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Class="mt-4" data-testid="enrol-submit">
        @Localizer["Account_EnrolTotp_Submit"]
    </MudButton>
</form>

@code {
    private string _formattedKey = string.Empty;

    [SupplyParameterFromQuery(Name = "error")]
    private string? Error { get; set; }

    protected override async Task OnInitializedAsync()
    {
        HttpContext http = HttpContextAccessor.HttpContext!;

        ApplicationUser? user = await Users.GetUserAsync(http.User);
        if (user is null)
        {
            // The [Authorize] attribute is the guard; this covers the narrow case of a
            // still-valid cookie for a user who no longer exists, which would otherwise
            // be a null dereference and a 500.
            Navigation.NavigateTo("/account/login", replace: true);
            return;
        }

        // THE guard. [Authorize] alone lets any authenticated session re-read the live
        // shared secret below, and posting a code from it regenerates the recovery codes --
        // so a stolen cookie became a permanent second-factor compromise that changing the
        // password does not undo. Task 12's gate confines flagged users TO this page; it
        // never kept unflagged users OFF it.
        //
        // MustEnrolTotp rather than TwoFactorEnabled, and the choice matters. This is the
        // gate's own predicate, so the set of users the gate confines here is exactly the
        // set this page admits. Any narrower condition -- "not enrolled yet", or that AND
        // the flag -- admits a state where the gate redirects a user to a page that then
        // refuses them, which is the infinite redirect loop recorded in
        // IMPLEMENTATION-NOTES.md, not a blocked page. The flag is also honest about what
        // it means: nothing sets it without first clearing TwoFactorEnabled and the
        // authenticator key (the administrator's clear-MFA endpoint and --reset-mfa both
        // do), so "owes an enrolment" and "has no second factor" are the same state.
        if (!user.MustEnrolTotp)
        {
            Navigation.NavigateTo("/", replace: true);
            return;
        }

        // The response below carries the shared secret, and it must not be cached. It is
        // not, and no line here does it: Blazor's endpoint renderer stores an antiforgery
        // token on every static-SSR render, and DefaultAntiforgery.SetDoNotCacheHeaders
        // sets "no-cache, no-store" when it does. Measured across every page in the
        // application, and pinned by EnrolTotpTests.The_pages_that_render_a_secret_forbid_caching
        // -- which is where to look if that ever stops being true.

        // Reuse an existing key rather than resetting on every visit. A user who verified
        // a code but left before acknowledging their recovery codes still has
        // MustEnrolTotp set and comes back here; resetting would silently kill the entry
        // they already added to their authenticator app, and the next code they read from
        // it would be rejected with no explanation.
        //
        // The key is reset only by --reset-mfa or an administrator's clear-TOTP.
        string? key = await Users.GetAuthenticatorKeyAsync(user);
        if (string.IsNullOrEmpty(key))
        {
            await Users.ResetAuthenticatorKeyAsync(user);
            key = await Users.GetAuthenticatorKeyAsync(user);

            // THE line, and it is the fix for a defect a green suite missed. Minting the key
            // is a two-factor change, so ResetAuthenticatorKeyAsync rotates the security
            // stamp -- but the cookie in the browser still carries the stamp it was issued
            // under. SecurityStampValidatorOptions.ValidationInterval is one minute, so for
            // the first minute nothing revalidates and the session looks fine; on the first
            // request after that the validator finds a stamp that no longer matches, rejects
            // the principal and signs the user out. Typing a code off a phone takes longer
            // than a minute, so POST /account/enrol-totp/verify then arrived unauthenticated:
            // its antiforgery token had been bound to a signed-in caller who no longer
            // existed, and the post failed with "the provided antiforgery token was meant for
            // a different claims-based user". Re-issuing the cookie under the new stamp is
            // the whole fix; the rotation itself is wanted.
            //
            // The same call for the same reason sits in the verify handler after
            // SetTwoFactorEnabledAsync. That one covered the rotation on the way OUT of this
            // page; this covers the rotation on the way IN, which is the one nobody noticed
            // because every test and every browser journey submits inside the minute.
            //
            // Writing a cookie from a component is safe here and only here: these pages are
            // static SSR (no component declares a render mode), so this runs while the
            // response headers are still open, and not inside a circuit's WebSocket message.
            await SignIn.RefreshSignInAsync(user);
        }

        _formattedKey = FormatKey(key ?? string.Empty);
    }

    private static string FormatKey(string key)
    {
        var builder = new StringBuilder();
        for (int i = 0; i < key.Length; i += 4)
        {
            builder.Append(key.AsSpan(i, Math.Min(4, key.Length - i))).Append(' ');
        }

        return builder.ToString().TrimEnd();
    }
}
