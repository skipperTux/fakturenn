@page "/account/change-password"
@* AntiforgeryToken lives in Components.Forms, which _Imports.razor does not carry. *@
@using Microsoft.AspNetCore.Components.Forms
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject IStringLocalizer<SharedResource> Localizer

<PageTitle>@Localizer["Account_ChangePassword_PageTitle"]</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true" data-testid="change-password-title">@Localizer["Account_ChangePassword_Title"]</MudText>
<MudText Typo="Typo.body2" Class="mb-4">
    @Localizer["Account_ChangePassword_Explanation"]
</MudText>

@* Error comes from POST /account/change-password/submit, which joins Identity's own
   validation descriptions -- already localized by LocalizedIdentityErrorDescriber. *@
@if (Error is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-4" data-testid="change-password-error">@Error</MudAlert>
}

<form method="post" action="/account/change-password/submit" data-testid="change-password-form">
    <AntiforgeryToken />
    <MudTextField T="string" Label="@Localizer["Account_ChangePassword_Current"]" InputType="InputType.Password" name="currentPassword" Required="true" data-testid="current-password" />
    <MudTextField T="string" Label="@Localizer["Account_ChangePassword_New"]" InputType="InputType.Password" name="newPassword" Required="true" data-testid="new-password" />
    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Class="mt-4" data-testid="change-password-submit">
        @Localizer["Account_ChangePassword_Submit"]
    </MudButton>
</form>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    private string? Error { get; set; }
}
