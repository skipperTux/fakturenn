@page "/account/login-recovery"
@* AntiforgeryToken lives in Components.Forms, which _Imports.razor does not carry. *@
@using Microsoft.AspNetCore.Components.Forms
@inject IStringLocalizer<SharedResource> Localizer

<PageTitle>@Localizer["Account_RecoveryLogin_PageTitle"]</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true" data-testid="recovery-login-title">@Localizer["Account_RecoveryLogin_Title"]</MudText>
<MudText Typo="Typo.body2" Class="mb-4">@Localizer["Account_RecoveryLogin_Explanation"]</MudText>

<FormError Error="@Error" Message="@Localizer["Account_RecoveryLogin_InvalidCode"]" TestId="recovery-error" />

<form method="post" action="/account/login-recovery/submit" data-testid="recovery-form">
    <AntiforgeryToken />
    <MudTextField T="string" Label="@Localizer["Account_RecoveryLogin_Code"]" name="code" Required="true" autocomplete="off" data-testid="recovery-login-code" />
    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Class="mt-4" data-testid="recovery-submit">
        @Localizer["Account_RecoveryLogin_Submit"]
    </MudButton>
</form>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    private string? Error { get; set; }
}
