@page "/account/denied"
@inject IStringLocalizer<SharedResource> Localizer

<PageTitle>@Localizer["Account_Denied_PageTitle"]</PageTitle>

@* Where ConfigureApplicationCookie's AccessDeniedPath sends an authenticated user who
   lacks the permission a page requires. *@
<MudAlert Severity="Severity.Error" data-testid="denied-message">
    @Localizer["Account_Denied_Message"]
</MudAlert>
