@page "/account/recovery-codes"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject IHttpContextAccessor HttpContextAccessor
@inject IStringLocalizer<SharedResource> Localizer

<PageTitle>@Localizer["Account_RecoveryCodes_PageTitle"]</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true" data-testid="recovery-codes-title">@Localizer["Account_RecoveryCodes_Title"]</MudText>

@if (_codes.Length == 0)
{
    <MudAlert Severity="Severity.Info" data-testid="recovery-empty">
        @Localizer["Account_RecoveryCodes_Empty"]
    </MudAlert>
}
else
{
    <MudAlert Severity="Severity.Warning" Class="mb-4">
        @Localizer["Account_RecoveryCodes_StoreNow"]
    </MudAlert>

    <MudPaper Class="pa-4" data-testid="recovery-codes">
        @* Not named "code": @code at the start of a razor expression is the directive. *@
        @foreach (string recoveryCode in _codes)
        {
            <MudText Typo="Typo.body1">@recoveryCode</MudText>
        }
    </MudPaper>
}

<MudButton Href="/" Variant="Variant.Filled" Color="Color.Primary" Class="mt-4" data-testid="recovery-continue">
    @Localizer["Account_RecoveryCodes_Continue"]
</MudButton>

@code {
    private string[] _codes = [];

    // Reading consumes: the helper clears the cookie, so a reload or a back-navigation
    // lands on the empty branch above. That is the intended "shown once" behaviour, and
    // its cost is real -- a user who leaves this page without writing the codes down
    // cannot get them back. The codes still work; nothing displays them again. E02a has
    // no regeneration page on purpose, so the recovery path is an administrator clearing
    // two-factor setup, which forces re-enrolment and issues a fresh set.
    protected override void OnInitialized() =>
        _codes = AccountEndpoints.TakeRecoveryCodes(HttpContextAccessor.HttpContext!);
}
