@page "/account/lockout"
@inject IStringLocalizer<SharedResource> Localizer

<PageTitle>@Localizer["Account_Lockout_PageTitle"]</PageTitle>

@* No countdown and no account name: this page is reachable by anyone who can guess an
   address, so it must say nothing an attacker could not already know. *@
<MudAlert Severity="Severity.Warning" data-testid="lockout-message">
    @Localizer["Account_Lockout_Message"]
</MudAlert>
