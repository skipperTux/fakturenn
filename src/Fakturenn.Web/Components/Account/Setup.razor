@page "/setup"
@using Fakturenn.Modules.Identity.Persistence
@* AntiforgeryToken lives in Components.Forms, which _Imports.razor does not carry. *@
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.EntityFrameworkCore
@inject IdentityDbContext Db
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResource> Localizer

<PageTitle>@Localizer["Setup_PageTitle"]</PageTitle>

@if (_alreadyConfigured)
{
    <MudText Typo="Typo.h5">@Localizer["Setup_AlreadyConfigured"]</MudText>
}
else
{
    <MudText Typo="Typo.h4" GutterBottom="true">@Localizer["Setup_CreateAdministrator"]</MudText>
    <MudText Typo="Typo.body2" Class="mb-4">
        @Localizer["Setup_Explanation"]
    </MudText>

    @* No Message, so the value is shown as it arrives: POST /account/setup builds it from
       Identity's own validation descriptions, localized by LocalizedIdentityErrorDescriber,
       and "Passwords must be at least 12 characters" is the whole point of showing it. *@
    <FormError Error="@Error" TestId="setup-error" />

    <form method="post" action="/account/setup" data-testid="setup-form">
        <AntiforgeryToken />
        <MudTextField T="string" Label="@Localizer["Setup_Email"]" InputType="InputType.Email" name="email" Value="@Email" Required="true" autocomplete="username" data-testid="setup-email" />
        <MudTextField T="string" Label="@Localizer["Setup_DisplayName"]" name="displayName" Value="@DisplayName" Required="true" autocomplete="name" data-testid="setup-display-name" />
        <MudTextField T="string" Label="@Localizer["Setup_Password"]" InputType="InputType.Password" name="password" Required="true" autocomplete="new-password" data-testid="setup-password" />
        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Class="mt-4" data-testid="setup-submit">
            @Localizer["Setup_Submit"]
        </MudButton>
    </form>
}

@code {
    private bool _alreadyConfigured;

    [SupplyParameterFromQuery(Name = "error")]
    private string? Error { get; set; }

    // Whatever the rejected post carried back. A refused password used to cost the operator
    // both other fields as well, on the one form in the application they meet before they
    // have an account to sign in with. The password is deliberately absent -- AccountForms
    // carries an allowlist, and no credential is on it.
    [SupplyParameterFromQuery(Name = "email")]
    private string? Email { get; set; }

    [SupplyParameterFromQuery(Name = "displayName")]
    private string? DisplayName { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _alreadyConfigured = await Db.Users.AnyAsync();

        if (_alreadyConfigured)
        {
            // A user-count query, not a configuration flag: a flag can be left on,
            // a populated table cannot.
            Navigation.NavigateTo("/account/login", replace: true);
        }
    }
}
