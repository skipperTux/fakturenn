@page "/setup"
@using Fakturenn.Modules.Identity.Persistence
@* AntiforgeryToken lives in Components.Forms, which _Imports.razor does not carry. *@
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.EntityFrameworkCore
@inject IdentityDbContext Db
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResource> Localizer

<PageTitle>@Localizer["Setup_PageTitle"]</PageTitle>

@if (_alreadyConfigured)
{
    <MudText Typo="Typo.h5">@Localizer["Setup_AlreadyConfigured"]</MudText>
}
else
{
    <MudText Typo="Typo.h4" GutterBottom="true">@Localizer["Setup_CreateAdministrator"]</MudText>
    <MudText Typo="Typo.body2" Class="mb-4">
        @Localizer["Setup_Explanation"]
    </MudText>

    @* Error is produced by POST /account/setup, which builds it from Identity's own
       validation descriptions -- localized by LocalizedIdentityErrorDescriber, so what
       arrives here is already in the request's language. *@
    @if (Error is not null)
    {
        <MudAlert Severity="Severity.Error" Class="mb-4" data-testid="setup-error">@Error</MudAlert>
    }

    <form method="post" action="/account/setup" data-testid="setup-form">
        <AntiforgeryToken />
        <MudTextField T="string" Label="@Localizer["Setup_Email"]" InputType="InputType.Email" name="email" Required="true" data-testid="setup-email" />
        <MudTextField T="string" Label="@Localizer["Setup_DisplayName"]" name="displayName" Required="true" data-testid="setup-display-name" />
        <MudTextField T="string" Label="@Localizer["Setup_Password"]" InputType="InputType.Password" name="password" Required="true" data-testid="setup-password" />
        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Class="mt-4" data-testid="setup-submit">
            @Localizer["Setup_Submit"]
        </MudButton>
    </form>
}

@code {
    private bool _alreadyConfigured;

    [SupplyParameterFromQuery(Name = "error")]
    private string? Error { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _alreadyConfigured = await Db.Users.AnyAsync();

        if (_alreadyConfigured)
        {
            // A user-count query, not a configuration flag: a flag can be left on,
            // a populated table cannot.
            Navigation.NavigateTo("/account/login", replace: true);
        }
    }
}
