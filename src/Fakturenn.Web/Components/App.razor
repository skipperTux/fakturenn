@using System.Globalization
<!DOCTYPE html>
@* Follows the culture UseRequestLocalization resolved for this request, not a fixed "en".
   German content served under lang="en" is read out by a screen reader with English
   phonetics, offered for translation into the language it is already in, and hyphenated
   by the wrong rules. TwoLetterISOLanguageName rather than Name because the supported
   cultures are the neutral "en" and "de"; a request for de-AT is resolved to "de" before
   this renders. *@
<html lang="@CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["Fakturenn.Web.styles.css"]" />
    <link rel="stylesheet" href="@Assets["_content/MudBlazor/MudBlazor.min.css"]" />
    <ImportMap />
    <HeadOutlet />
</head>

<body>
    <Routes />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["_content/MudBlazor/MudBlazor.min.js"]"></script>
</body>

</html>
