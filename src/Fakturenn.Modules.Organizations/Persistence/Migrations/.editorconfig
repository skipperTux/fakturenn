# EF Core's migration codegen always emits block-scoped namespaces, and it
# regenerates these files' exact shape on every 'dotnet ef migrations add'.
# Overriding the generator's output style would only produce needless diffs
# against the tool's own format, so this generated-only folder is exempt from
# the repository's file-scoped-namespace rule instead.
[*.cs]
csharp_style_namespace_declarations = file_scoped:none

# The generator also always emits `using System;`, which ImplicitUsings makes
# redundant, so IDE0005 (error repository-wide) fires on every generated
# migration that touches a System type. Same reasoning as above: exempt the
# generated-only folder rather than strip a using the next `migrations add`
# would put straight back.
dotnet_diagnostic.IDE0005.severity = none

# HasData makes the generator emit `new[] { ... }` column and value arrays inline in
# InsertData, which CA1861 rejects. The migration runs once, so the allocation is
# irrelevant, and the generator would re-emit it on the next 'migrations add'.
dotnet_diagnostic.CA1861.severity = none
