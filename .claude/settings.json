{
    "permissions": {
        "allow": [
            "Bash(git diff:*)",
            "Bash(git status:*)",
            "Bash(git log:*)",
            "Bash(git show:*)",
            "Bash(git blame:*)",
            "Bash(git branch --list:*)",
            "Bash(git branch -v:*)",
            "Bash(git branch -vv:*)",
            "Bash(git branch --show-current)",
            "Bash(dotnet build:*)",
            "Bash(dotnet test:*)",
            "Bash(dotnet format --verify-no-changes:*)",
            "Bash(dotnet list:*)",
            "Bash(dotnet --info)",
            "Bash(dotnet --version)",
            "Bash(shellcheck:*)",
            "Bash(yamllint:*)"
        ],
        "ask": [
            "Bash(git commit:*)"
        ],
        "deny": [
            "Bash(git sparse-checkout)",
            "Bash(git sparse-checkout:*)",
            "Bash(git bob -d:*)",
            "Bash(git-bob -d:*)",
            "Bash(git bob --off:*)",
            "Bash(git-bob --off:*)",
            "Bash(git bob --preserve-clear:*)",
            "Bash(git-bob --preserve-clear:*)",
            "Bash(git push:*)",
            "Bash(git reset --hard:*)",
            "Bash(git clean -fd:*)",
            "Bash(git clean -fdx:*)",
            "Bash(rm -rf:*)",
            "Bash(dotnet nuget push:*)",
            "Bash(dotnet nuget delete:*)",

            "Read(./**/appsettings.Staging.json)",
            "Write(./**/appsettings.Staging.json)",
            "Edit(./**/appsettings.Staging.json)",
            "Read(./**/appsettings.Production.json)",
            "Write(./**/appsettings.Production.json)",
            "Edit(./**/appsettings.Production.json)",
            "Read(./**/appsettings.User*.json)",
            "Write(./**/appsettings.User*.json)",
            "Edit(./**/appsettings.User*.json)",
            "Read(./**/appsettings.user*.json)",
            "Write(./**/appsettings.user*.json)",
            "Edit(./**/appsettings.user*.json)",
            "Read(./**/Credentials.cs)",
            "Write(./**/Credentials.cs)",
            "Edit(./**/Credentials.cs)",
            "Read(~/**/.env)",
            "Write(~/**/.env)",
            "Edit(~/**/.env)",
            "Read(./**/*secrets.json)",
            "Write(./**/*secrets.json)",
            "Edit(./**/*secrets.json)",
            "Read(./**/*secrets.y*ml)",
            "Write(./**/*secrets.y*ml)",
            "Edit(./**/*secrets.y*ml)",
            "Read(./**/vault.env)",
            "Write(./**/vault.env)",
            "Edit(./**/vault.env)",
            "Read(./**/vault.*.env)",
            "Write(./**/vault.*.env)",
            "Edit(./**/vault.*.env)",
            "Read(./**/*vault.y*ml)",
            "Write(./**/*vault.y*ml)",
            "Edit(./**/*vault.y*ml)"
        ]
    },
    "disableBypassPermissionsMode": "disable"
}